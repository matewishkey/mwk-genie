#!/usr/bin/env bash
# mwk — three commands. Everything else, the agent does.
#
#   mwk add NAME                    put a key in the store. YOU type it; it never goes through chat
#   mwk run -- <command>            run something with your keys in its environment
#   mwk update                      get the newest version of the kit
#
# THE RULE THIS FILE IS SHAPED BY (mate, 2026-09-17): a command exists only if it is needed
# OFTEN. `init`, `list`, `needs`, `lock`, `rekey`, `uninstall`, a menu — all gone; the agent on
# the machine handles a one-off better than a function written months earlier for it. `add`
# survives because it is the one thing that structurally needs a human at a keyboard; `run`
# because the agent types it constantly; `update` because it has to work when the agent's
# own instructions are stale.
#
# THE STORE is ~/projects/keys — a private git repo holding ONE sops-encrypted dotenv file,
# keys.enc.env, and ONE plain age key at sops's default path, ~/.config/sops/age/keys.txt.
# One file, no per-project scope (mate, 2026-09-17: "one global password manager, do not
# overcomplicate it"). The thing they save in their password manager is that key's
# AGE-SECRET-KEY line, once. Measured under env -i with sops 3.13.3 / age 1.1.1: sops finds
# the default key path unaided; a hidden key fails decryption instantly (exit 128 — the hang
# was pinentry, and pinentry is gone); a new key + `sops updatekeys` locks the old one out;
# `git add -A` stages zero secret lines. docs/v3-plan.md has the table.
#
# No --value flag anywhere, deliberately. A value passed as an argument lands in argv, in
# ps, in shell history and in an agent transcript. Deleting the flag removes the class.
#
# FIVE THINGS AN EXTERNAL REVIEW FOUND ON 2026-09-17, each reproduced, each now asserted by
# check.sh — see the comment where each is fixed:
#   1. `pub=$(grep … | head -1)` under pipefail died with NO output on the exact recovery
#      path the tool prints (a one-line key file has no public-key line).
#   2. `set -a; . "$tmp"` SOURCED the decrypted dotenv: a value with a backtick ran as code,
#      a value with a space broke the command it was meant to feed.
#   3. `read -rs` takes one line; a pasted multi-line secret was truncated and the rest was
#      handed to the interactive shell — then "Stored. Not in your history." Both false.
#   4. `mwk run` with the store file missing ran the command with NO keys, exit 0.
#   5. (install.sh) the version regex missed any pin with a trailing comment.
set -euo pipefail

STORE="${MWK_STORE:-$HOME/projects/keys}"
KEY="${MWK_KEY:-$HOME/.config/sops/age/keys.txt}"
KEYS="$STORE/keys.enc.env"

# Set explicitly, never inherited. A shell that already exports SOPS_AGE_KEY_FILE (this
# repo's own dev box does) silently points every decrypt at somebody else's key — that
# is exactly how the first round of store research produced a recipient mismatch nobody
# could explain. Ours, always.
export SOPS_AGE_KEY_FILE="$KEY"
unset SOPS_AGE_KEY SOPS_AGE_RECIPIENTS 2>/dev/null || true

# Mate Wish Key red is #e2342b — truecolor where the terminal says it can do it, the
# nearest xterm-256 red otherwise, and NOTHING when output is not a terminal. A value
# piped into a file must never arrive wrapped in escape codes.
if [ -t 1 ]; then
  case "${COLORTERM:-}" in
    truecolor|24bit) RED=$(printf '\033[38;2;226;52;43m') ;;
    *)               RED=$(printf '\033[38;5;203m') ;;
  esac
  B=$(printf '\033[1m'); GRN=$(printf '\033[32m'); R=$(printf '\033[0m')
else
  RED=''; B=''; GRN=''; R=''
fi

die()  { printf '%smwk:%s %s\n' "$RED" "$R" "$*" >&2; exit 1; }
note() { printf '%s\n' "$*" >&2; }
good() { printf '%s%s%s\n' "$GRN" "$*" "$R" >&2; }

usage() { cat <<'EOF'
mwk — your keys, in one place.

  mwk add NAME                    put a key in. You type it; it never goes through the chat
  mwk run -- <command>            run something with your keys, just for that command
  mwk update                      get the newest version of all of this

There is no way to print a value, and no --value flag. That is on purpose.
Anything else — seeing what you have, a new computer, a new key — ask me in the chat.
EOF
}

# The one boundary. `add` reads a secret, so it needs a person at a keyboard.
#
# It does NOT test stdout. `[ -t 1 ]` asks about the CURRENT REDIRECTION, not whether a
# person is there — measured 2026-08-30, the same test answers "human" at the top of a
# command and "nobody" one pipe later. The property that actually holds is whether the
# controlling terminal can be OPENED. From an agent's shell /dev/tty is not openable, so
# this refuses there, which is the enforcement it exists for.
have_tty() { [ -t 0 ] && (exec 3<>/dev/tty) 2>/dev/null; }
require_tty() {
  have_tty && return 0
  cat >&2 <<'EOF'
mwk: this needs your own terminal, and this isn't one.

  Nothing is wrong. Keys are only ever typed where nothing is watching,
  and an AI agent has no keyboard — so it cannot be here for this bit.

  Open a new tab in your terminal — Cmd+T on a Mac. On Windows it must be an
  UBUNTU tab (the arrow next to the + in Windows Terminal), not PowerShell:
  if the new tab starts with PS C:\ nothing here exists in it.
  Run the command there, then come back. Do NOT quit Claude.
EOF
  exit 3
}

# Only the two commands that touch the store need sops. `mwk` alone and `mwk update` must
# work with NOTHING else on PATH — update is what you run when things are broken, and a
# login shell (`su - user -c`, a cron, a fresh tab before ~/.mwk-shell.sh) has ~/bin but not
# mise's shims. The container rehearsal caught this: a preflight here made usage exit 1.
need_tools() {
  for t in sops age-keygen; do
    command -v "$t" >/dev/null 2>&1 || die "$t is not on PATH — open a new terminal tab, or run 'mwk update'"
  done
}

# `command -v git` is TRUE on every Mac with no developer tools — /usr/bin/git is Apple's
# xcode-select shim, and calling it pops an install dialog and fails. install.sh asks
# `xcode-select -p`; so does this, or the store's `git init` would silently never happen.
have_git() {
  command -v git >/dev/null 2>&1 || return 1
  if [ "$(uname -s)" = Darwin ] && ! xcode-select -p >/dev/null 2>&1; then return 1; fi
  return 0
}

# `--config` rather than trusting the search: sops looks for .sops.yaml upward from the
# CURRENT DIRECTORY, and `mwk add` is run from wherever they are standing, not the store.
# `--filename-override` because the input is stdin, and the creation rule matches on the
# file's NAME — without it there is "no matching creation rules found" (measured), which
# is the no-catch-all rule doing its job on the wrong file.
sops_d() { [ -f "$1" ] || return 0; sops -d --input-type dotenv --output-type dotenv "$1"; }
sops_e() {
  # `sops -e ... > "$f"` truncates $f before sops runs, so a failed encrypt would DELETE
  # the store. Write to a temp and move it into place.
  t="$1.tmp.$$"
  if sops -e --config "$STORE/.sops.yaml" --filename-override "$1" \
       --input-type dotenv --output-type dotenv /dev/stdin > "$t" 2>/dev/null; then
    mv "$t" "$1"
  else
    rm -f "$t"; die "could not write to the store — nothing was changed"
  fi
}

# First `add` on a machine makes the store. There is no `init`: a person's first key is
# the first time there is anything to initialise, and it is the moment they are already
# at a keyboard doing exactly this.
ensure_store() {
  # A store with no key is a NEW COMPUTER (or a lost file), not a first run. Minting a
  # fresh key here would encrypt the next add to a key that cannot read the rest of the
  # repo — and it would look like it worked. The saved key is the only way forward.
  # EITHER file counts as "a store exists": the review found that a half-restored folder
  # (keys.enc.env copied, .sops.yaml not) minted a new key over their data and then wrote
  # that bogus key into .sops.yaml, wedging every later add with no diagnostic.
  if [ ! -s "$KEY" ] && { [ -f "$STORE/.sops.yaml" ] || [ -f "$KEYS" ]; }; then
    cat >&2 <<EOF
mwk: your keys are here ($STORE) but the key that opens them is not.

  It is the AGE-SECRET-KEY line you saved in your password manager. Put it in a file at
    $KEY
  (one line, nothing else), then run this again. Ask me in the chat and I will walk
  you through it — but paste the key into that file, never into the chat.
EOF
    exit 1
  fi
  if [ ! -s "$KEY" ]; then
    mkdir -p "$(dirname "$KEY")"; chmod 700 "$(dirname "$KEY")"
    age-keygen -o "$KEY" 2>/dev/null; chmod 600 "$KEY"
    made_key=1
  fi
  # DERIVE the public key; never grep for it. The file they restore by hand is exactly one
  # line — the secret — with no "# public key:" comment, and `grep … | head` under pipefail
  # killed the script with nothing on screen, on precisely the path the message above
  # tells them to take. `age-keygen -y` computes it from the secret (measured identical).
  pub=$(age-keygen -y "$KEY" 2>/dev/null || true)
  [ -n "$pub" ] || die "the key at $KEY does not look like an age key (it should be one line starting AGE-SECRET-KEY-1)"
  if [ ! -f "$STORE/.sops.yaml" ]; then
    mkdir -p "$STORE"
    # One rule and no catch-all: a file matching nothing fails loudly instead of being
    # encrypted to the wrong set. This file holds the PUBLIC key and is safe to commit.
    printf 'creation_rules:\n  - path_regex: \\.enc\\.env$\n    age: %s\n' "$pub" > "$STORE/.sops.yaml"
    have_git && git -C "$STORE" init -q 2>/dev/null || true
  fi
  if [ -n "${made_key:-}" ]; then
    cat >&2 <<EOF

  ${B}${RED}Your key was just made, and there is one thing to do once.${R}

  Everything in $STORE is locked with a key that lives at
    $KEY
  and nowhere else. If this computer dies, that file is the only way back in.

  Open a NEW tab in your terminal and type:   cat $KEY
  Copy the line that starts AGE-SECRET-KEY into your password manager, as a
  new entry called "mwk key". Then type 'clear' so it is not in your scroll-back.

  Never paste that line into the chat. The agent does not need it and must not have it.

EOF
  fi
}

# Adding a key REPLACES the file it lives in, so every other key in that file has to
# survive the trip. It did not once: measured 2026-08-30, three adds with the correct
# password left one key, each printing a green "Stored". Each line below is load-bearing,
# and check.sh runs this against a real scratch store and reads every name back.
cmd_add() {
  require_tty      # first: "this needs your keyboard" is the answer that hands it to a person
  need_tools       # then: at a person's terminal, a missing sops is a PATH problem, said plainly
  name="${1:-}"
  [ -n "$name" ] && [ $# -eq 1 ] || die "usage: mwk add NAME"
  printf '%s' "$name" | grep -qE '^[A-Za-z_][A-Za-z_0-9]*$' || die "a name must look like OPENAI_API_KEY"
  f="$KEYS"
  ensure_store
  [ -f "$f" ] || { : | sops_e "$f"; }

  # Read BEFORE asking for the value, and refuse to go on if the read failed. A failed
  # read used to mean "carry on and write the file anyway", which is the whole bug.
  old=$(sops_d "$f") || die "could not read what is already in your store — nothing was changed"

  printf 'Paste the value for %s (it will not appear on screen): ' "$name" >&2
  IFS= read -rs value; printf '\n' >&2
  # ONE LINE. `read` takes one line and a pasted multi-line secret used to leave the rest
  # of the paste sitting in the terminal — to be run as commands, and written to history,
  # by the shell this returns to, under a green "not in your history". Drain whatever is
  # still pending (it is never echoed), and if there was anything, store nothing.
  extra=0
  while IFS= read -rs -t 1 _more; do extra=1; done
  [ "$extra" = 0 ] || die "that was more than one line. A key here is one line — nothing was stored. For something with several lines (a certificate, a private key file), ask me in the chat"
  [ -n "$value" ] || die "nothing pasted — no change made"

  # Keep the old ciphertext until the new one is PROVED good. This is a key store: the
  # failure that matters is not "the write failed", it is "the write succeeded and took
  # the rest of the file with it".
  [ -s "$f" ] && cp "$f" "$f.prev"
  new=$(
    [ -n "$old" ] && { printf '%s\n' "$old" | grep -vE "^${name}=" | grep -v '^[[:space:]]*$' || true; }
    printf '%s=%s\n' "$name" "$value"
  )
  printf '%s\n' "$new" | sops_e "$f"

  # Read it back and ASSERT THE RESULT: every name that was in there must still be in
  # there, and the new one must have arrived WITH ITS VALUE. Otherwise put the old file back.
  now=$(sops_d "$f") || now=""
  lost=""
  for n in $(printf '%s\n' "$old" | grep -oE '^[A-Za-z_][A-Za-z_0-9]*' || true); do
    printf '%s\n' "$now" | grep -qE "^$n=" || lost="$lost $n"
  done
  if [ -n "$lost" ] || ! printf '%s\n' "$now" | grep -qF "$name=$value"; then
    [ -f "$f.prev" ] && mv "$f.prev" "$f"
    [ -n "$lost" ] && die "your store did not come back right, so I put it back as it was. Nothing changed. Missing:$lost"
    die "your store did not come back right, so I put it back as it was. Nothing changed."
  fi
  rm -f "$f.prev"

  # A commit is local and free, and it is the difference between "on this disk" and "in
  # the history". Pushing is /mwk-save's job — that needs GitHub, this needs nothing.
  if [ -d "$STORE/.git" ]; then
    git -C "$STORE" add -A >/dev/null 2>&1 && git -C "$STORE" commit -qm "add $name" >/dev/null 2>&1 || true
  fi
  good "Stored $name. It is not on screen and not in your history."
}

cmd_run() {
  need_tools
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "usage: mwk run -- <command>"
  [ -s "$KEY" ] || die "no key at $KEY — add a key first (mwk add NAME), or put your saved key there"
  # The STORE FILE too. `sops_d` treats a missing file as empty (which `add` relies on for
  # the very first key), so without this line a missing store ran the command with no keys
  # at all, exit 0, and nothing said so — reproduced by the review.
  [ -f "$KEYS" ] || die "nothing is stored yet at $KEYS — add a key first (mwk add NAME)"
  # A template, because BSD mktemp (macOS) wants one; GNU accepts it too.
  tmp="$(mktemp "${TMPDIR:-/tmp}/mwk.XXXXXX")"; chmod 600 "$tmp"; trap 'rm -f "$tmp"' EXIT
  { sops_d "$KEYS" || die "could not read your keys"; } > "$tmp"
  # NEVER `. "$tmp"`. sops writes KEY=value with no quoting, and sourcing that made a value
  # containing a backtick RUN as code and a value with a space break the command it was
  # meant to feed — both reproduced. Parse the lines instead: the value is whatever follows
  # the first `=`, byte for byte, and the name has to look like a name or it is skipped.
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue;; esac
    k=${line%%=*}; v=${line#*=}
    printf '%s' "$k" | grep -qE '^[A-Za-z_][A-Za-z_0-9]*$' || continue
    export "$k=$v"
  done < "$tmp"
  rm -f "$tmp"
  exec "$@"
}

# Delegates to the kit's own install.sh: there is ONE list of what gets installed and it
# lives next to the thing that installs it. install.sh is written to be re-run — it pulls
# the kit, skips every tool it already has, and re-applies — so "update" and "install"
# are the same code path, which is the only way they stay in step.
#
# It runs the installer that is ON DISK, so a change to install.sh itself lands on the
# run AFTER the one that pulled it. That is ordinary self-update lag and it is fine.
cmd_update() {
  u="$HOME/projects/mwk-genie/install.sh"
  [ -f "$u" ] || die "the kit is not at ~/projects/mwk-genie, so there is nothing to update"
  note "Updating. This takes a minute or two, and it will not ask you for anything."
  exec sh "$u" "$@"
}

case "${1:-}" in
  add)    shift; cmd_add "$@";;
  run)    shift; cmd_run "$@";;
  update) shift; cmd_update "$@";;
  ""|-h|--help|help) usage;;
  *) usage; die "unknown command: $1";;
esac
