#!/usr/bin/env bash
# mwk — the kit's secret store. One store, two scopes, one master password.
#
# WHY THIS SHAPE (measured 2026-08-28, not remembered):
#   * The store is a passphrase-encrypted age identity + sops-encrypted dotenv files.
#     `sops` decrypts using a passphrase-protected identity file — confirmed working with
#     sops 3.13.3 / age 1.1.1. The passphrase is prompted through pinentry.
#   * pinentry needs a TTY. An agent (Claude Code's Bash tool) has none — no stdin tty,
#     no stdout tty, and /dev/tty cannot even be opened. So `add`/`init`/`rekey` REFUSE
#     there rather than being trusted not to. That is enforcement, not a convention.
#   * ⚠ gpg-agent CACHES the passphrase (default-cache-ttl 600s, max 7200s). So for that
#     window an agent CAN decrypt, TTY or not. Measured: flush the cache and the same
#     no-TTY command fails; unlock at a real terminal and it succeeds again immediately.
#     `mwk lock` exists because of this, and it is the only thing that makes "locked" true.
#   * No --value flag anywhere, deliberately. A value passed as an argument lands in argv,
#     in ps, in shell history and in an agent transcript. Deleting the flag removes the
#     class; HIST_IGNORE_SPACE only mitigates it.
set -euo pipefail

# The store lives OUTSIDE ~/mwk, and that is structural rather than tidy. ~/mwk/site is
# handed to a web server; anything under it is one `ln -s` or one forgotten flag away from
# being served. Measured 2026-08-30: with the store as a plain subdirectory of the served
# root, `GET /store/identity.age` returned 200 — from the LAN, because miniserve binds
# 0.0.0.0 by default. "It is a dotfile and miniserve hides those" survives exactly until
# someone adds -H to work out why a file is missing. Not being under the root survives that.
STORE="${MWK_STORE:-$HOME/.mwk}"
SITE="${MWK_SITE:-$HOME/mwk/site}"
ID_ENC="$STORE/identity.age"
ID_PUB="$STORE/identity.pub"
GLOBAL="$STORE/global.enc.env"
PROJ_DIR="$STORE/projects"
NEEDS_FILE=".mwk-keys"

# Mate Wish Key red is #e2342b — truecolor where the terminal says it can do it, the
# nearest xterm-256 red otherwise, and NOTHING when output is not a terminal. A value
# piped into a file must never arrive wrapped in escape codes.
if [ -t 1 ]; then
  case "${COLORTERM:-}" in
    truecolor|24bit) RED=$(printf '\033[38;2;226;52;43m') ;;
    *)               RED=$(printf '\033[38;5;203m') ;;
  esac
  B=$(printf '\033[1m'); DIM=$(printf '\033[2m'); GRN=$(printf '\033[32m'); R=$(printf '\033[0m')
else
  RED=''; B=''; DIM=''; GRN=''; R=''
fi

die() { printf '%smwk:%s %s\n' "$RED" "$R" "$*" >&2; exit 1; }
note() { printf '%s\n' "$*" >&2; }
good() { printf '%s%s%s\n' "$GRN" "$*" "$R" >&2; }

# The one boundary. Everything that touches a plaintext value goes through this.
have_tty() { [ -t 0 ] && [ -t 1 ] && (exec 3<>/dev/tty) 2>/dev/null; }
require_tty() {
  have_tty && return 0
  cat >&2 <<'EOF'
mwk: this needs your own terminal, and this isn't one.

  Nothing is wrong. Secrets are only ever typed where nothing is watching,
  and an AI agent has no keyboard — so it cannot be here for this bit.

  Open a new tab in your terminal (Cmd+T on a Mac, Ctrl+Shift+T otherwise),
  run the command there, then come back. Do NOT quit Claude.
EOF
  exit 3
}

slug() { basename "$(pwd)" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | sed 's/-*$//'; }
scope_file() { case "$1" in global) printf '%s' "$GLOBAL";; *) printf '%s' "$PROJ_DIR/$1.enc.env";; esac; }
store_exists() { [ -f "$ID_ENC" ] && [ -f "$ID_PUB" ]; }
recipient() { cat "$ID_PUB"; }

# Reading is the dangerous direction, for two reasons found by testing rather than reasoning:
#
#  1. With a cold gpg-agent cache and no TTY, sops does not fail — it HANGS waiting on a
#     pinentry that can never appear. Measured: a bare `sops -d` sat there until a 2-minute
#     timeout killed it. So when there is no TTY we bound it and call a timeout "locked".
#     With a TTY we must NOT bound it: that is a human being asked to type a password.
#
#  2. `sops -e ... > "$f"` truncates $f before sops runs. A failed encrypt therefore DELETES
#     the store. Write to a temp and move it into place instead.
# "" when there is nothing to bound with, which is the correct macOS behaviour.
TIMEOUT=""
if command -v timeout >/dev/null 2>&1; then TIMEOUT="timeout ${MWK_LOCK_PROBE:-6}"
elif command -v gtimeout >/dev/null 2>&1; then TIMEOUT="gtimeout ${MWK_LOCK_PROBE:-6}"; fi

# Unlock ONCE per invocation. Without this a Mac asks for the master password separately
# for the global file and the project file — twice for one `mwk list`, which reads as
# broken. The key is held in this process's environment and NEVER written to disk: a
# plaintext identity in a temp file would outlive `mwk run`, because that ends in `exec`
# and an EXIT trap never fires after exec.
unlock_once() {
  [ -n "${SOPS_AGE_KEY:-}" ] && return 0
  have_tty || return 0
  SOPS_AGE_KEY="$(age -d "$ID_ENC")" || die "wrong password, or the store is damaged"
  export SOPS_AGE_KEY
}

locked_msg() {
  cat >&2 <<'EOF'
mwk: your keys are locked, and I can't unlock them — that needs your password.

  Open a new tab in your terminal and run:   mwk list
  Type your master password once, come back, and I'll be able to see the names.
EOF
  exit 3
}

# Probe the lock state once, in the main shell, so `exit` actually exits and the
# message is printed once rather than once per store file.
preflight_read() {
  have_tty && { unlock_once; return 0; }
  [ -f "$GLOBAL" ] || return 0
  SOPS_AGE_KEY_FILE="$ID_ENC" $TIMEOUT \
    sops -d --input-type dotenv --output-type dotenv "$GLOBAL" >/dev/null 2>&1 || locked_msg
}

sops_d() {
  [ -f "$1" ] || return 0
  if have_tty; then
    SOPS_AGE_KEY_FILE="$ID_ENC" sops -d --input-type dotenv --output-type dotenv "$1"
  else
    SOPS_AGE_KEY_FILE="$ID_ENC" $TIMEOUT \
      sops -d --input-type dotenv --output-type dotenv "$1" 2>/dev/null || locked_msg
  fi
}

sops_e() {
  t="$1.tmp.$$"
  if SOPS_AGE_KEY_FILE="$ID_ENC" sops -e --age "$(recipient)" \
       --input-type dotenv --output-type dotenv /dev/stdin > "$t" 2>/dev/null; then
    mv "$t" "$1"
  else
    rm -f "$t"; die "could not write to the store — nothing was changed"
  fi
}

names_of() { sops_d "$1" | grep -oE '^[A-Za-z_][A-Za-z_0-9]*' || true; }

cmd_init() {
  require_tty
  store_exists && die "a store already exists at $STORE (use 'mwk rekey' to change the password)"
  mkdir -p "$PROJ_DIR"; chmod 700 "$STORE" "$PROJ_DIR"
  tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
  # age-keygen -o refuses to overwrite an existing file, and mktemp has already made one.
  age-keygen > "$tmp" 2>/dev/null
  grep -oE 'age1[a-z0-9]+' "$tmp" | head -1 > "$ID_PUB"
  cat <<'EOF'

  Your master password
  ────────────────────
  Everything you keep here is locked with one password. It is the only way in.
  Nobody can reset it — not me, not anyone. Put it in your password manager now,
  before you type it, and it will never be a problem again.

EOF
  age -p -a -o "$ID_ENC" "$tmp"
  chmod 600 "$ID_ENC"
  : | sops_e "$GLOBAL"
  note "Store created at $STORE"
}

cmd_add() {
  require_tty
  store_exists || die "no store yet — run 'mwk init' first"
  name="${1:-}"; scope="${2:-project}"
  [ -n "$name" ] || die "usage: mwk add NAME [global|project]"
  printf '%s' "$name" | grep -qE '^[A-Za-z_][A-Za-z_0-9]*$' || die "a name must look like OPENAI_API_KEY"
  case "$scope" in global) f="$GLOBAL";; project) f="$(scope_file "$(slug)")";; *) die "scope is 'global' or 'project'";; esac
  [ -f "$f" ] || { mkdir -p "$(dirname "$f")"; : | sops_e "$f"; }
  printf 'Paste the value for %s (it will not appear on screen): ' "$name" >&2
  IFS= read -rs value; printf '\n' >&2
  [ -n "$value" ] || die "nothing pasted — no change made"
  { sops_d "$f" | grep -vE "^${name}=" || true; printf '%s=%s\n' "$name" "$value"; } | sops_e "$f"
  good "Stored $name ($scope). It is not on screen and not in your history."
}

cmd_list() {
  store_exists || die "no store yet — run 'mwk init' first"
  preflight_read
  printf '%s%-34s %s%s\n' "$DIM" NAME SCOPE "$R"
  names_of "$GLOBAL" | while read -r n; do printf '%-34s %s\n' "$n" global; done
  names_of "$(scope_file "$(slug)")" | while read -r n; do printf '%-34s %s\n' "$n" "project($(slug))"; done
}

cmd_run() {
  store_exists || die "no store yet — run 'mwk init' first"
  preflight_read
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "usage: mwk run -- <command>"
  tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
  { sops_d "$GLOBAL"; sops_d "$(scope_file "$(slug)")"; } > "$tmp"
  set -a; . "$tmp"; set +a; rm -f "$tmp"
  unset SOPS_AGE_KEY          # never hand the master key to the command being wrapped
  exec "$@"
}

cmd_needs() {
  store_exists || die "no store yet — run 'mwk init' first"
  preflight_read
  { names_of "$GLOBAL" | sed 's/$/ global/'
    names_of "$(scope_file "$(slug)")" | sed 's/$/ project/'; } | sort > "$NEEDS_FILE"
  note "Wrote $NEEDS_FILE — names only, no values. Safe to commit."
}

# Serve the page. Three things here are not defaults, and each was measured today:
#   -i 127.0.0.1  miniserve otherwise binds "[::]:29292, 0.0.0.0:29292" and the page is
#                 readable by everyone on the wifi. Verified: a fetch from this box's LAN
#                 address returned 200.
#   -P            symlinks are followed by default. Verified: a symlink from the served
#                 root into the store returned the ciphertext with a 200.
#   the overlap check below, because both of those are flags and flags get changed.
cmd_site() {
  [ -f "$SITE/index.html" ] || die "no page at $SITE — run 'chezmoi apply' first"
  a=$(cd "$SITE" 2>/dev/null && pwd -P) || die "cannot resolve $SITE"
  # Fall back to the literal path when the store does not exist yet — which is the normal
  # state on a fresh machine, before `mwk init`. A check that goes quiet in the one state
  # it is most needed is not a check.
  b=$(cd "$STORE" 2>/dev/null && pwd -P) || b="$STORE"
  case "$a/" in "$b/"*) die "refusing: the page directory is inside the store ($b)";; esac
  case "$b/" in "$a/"*) die "refusing: the store is inside the page directory ($a)";; esac
  if command -v curl >/dev/null 2>&1 && curl -s -o /dev/null --max-time 2 http://127.0.0.1:29292/; then
    note "Already open: http://127.0.0.1:29292/"; return 0
  fi
  # An agent has no terminal to give up, and `exec miniserve` never returns — so running
  # this the obvious way would hang the tool call until it timed out, and the page the
  # whole flow depends on would look broken. With no tty, detach and come straight back.
  if have_tty; then
    note "Your page: http://127.0.0.1:29292/   (Ctrl+C here stops it)"
    exec miniserve -i 127.0.0.1 -P --index index.html --port 29292 "$a"
  fi
  if command -v setsid >/dev/null 2>&1; then
    setsid miniserve -i 127.0.0.1 -P --index index.html --port 29292 "$a" >/dev/null 2>&1 < /dev/null &
  else
    # macOS has no setsid. nohup plus a background job is the portable equivalent.
    nohup miniserve -i 127.0.0.1 -P --index index.html --port 29292 "$a" >/dev/null 2>&1 < /dev/null &
  fi
  sleep 1
  good "Their page is open: http://127.0.0.1:29292/"
}

# The page's producer. It existed only as a sentence in a JavaScript comment: the site
# polled queue.json and nothing anywhere wrote one, so v2's whole handover mechanism had
# no writer. Asking an agent to hand-write JSON is the exact class of thing this kit
# stopped doing when install.sh replaced a prose document.
#
#   mwk queue "why this is yours to run" "the command"
#   mwk queue --clear
cmd_queue() {
  Q="$SITE/queue.json"
  mkdir -p "$SITE"
  if [ "${1:-}" = "--clear" ]; then printf '{"commands":[]}\n' > "$Q"; note "Page cleared."; return 0; fi
  [ $# -eq 2 ] || die 'usage: mwk queue "<why it is theirs to run>" "<command>"'
  why="$1"; run="$2"
  # jq keeps this honest about quoting; without it, a command containing a quote would
  # produce a JSON file the page silently fails to parse — and a page that shows nothing
  # looks identical to a page with nothing to show.
  command -v jq >/dev/null 2>&1 || die "queueing needs jq (mise install)"
  [ -f "$Q" ] && jq -e . "$Q" >/dev/null 2>&1 || printf '{"commands":[]}\n' > "$Q"
  tmp="$Q.tmp.$$"
  jq --arg w "$why" --arg r "$run" '.commands += [{why:$w, run:$r}]' "$Q" > "$tmp" && mv "$tmp" "$Q"
  note "Put on their page: $run"
}

# Handing this to the script in the kit rather than reimplementing it: there is one list of
# what gets removed, and it lives next to the thing that installs it.
cmd_uninstall() {
  u="$HOME/projects/mwk-genie/uninstall.sh"
  [ -f "$u" ] || die "the kit is not at ~/projects/mwk-genie, so I cannot take it off cleanly"
  exec sh "$u" "$@"
}

cmd_lock() { gpg-connect-agent reloadagent /bye >/dev/null 2>&1 || true; note "Locked. The next command will ask for your master password."; }

cmd_rekey() {
  require_tty
  store_exists || die "no store yet"
  tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
  note "Enter your CURRENT master password:"
  age -d -o "$tmp" "$ID_ENC"
  note "Now choose a NEW one — save it in your password manager first:"
  age -p -a -o "$ID_ENC.new" "$tmp" && mv "$ID_ENC.new" "$ID_ENC" && chmod 600 "$ID_ENC"
  cmd_lock
  note "Done. The old password no longer opens anything."
}

usage() { cat <<'EOF'
mwk — your keys, in one place, behind one password.

  mwk                      (on your own terminal) a menu of the things you can do
  mwk init                 make the store (asks for a master password, once)
  mwk site                 open your page at http://127.0.0.1:29292/
  mwk queue "why" "cmd"    put a command on their page (for the agent, not them)
  mwk add NAME [scope]     add a key. scope is 'project' (default) or 'global'
  mwk list                 what you have — names only, never values
  mwk run -- <command>     run something with your keys, just for that command
  mwk needs                write .mwk-keys: what this project uses. Safe to commit
  mwk lock                 forget the master password until you type it again
  mwk rekey                change the master password
  mwk uninstall            take all of this back off this computer

There is no way to print a value, and no --value flag. That is on purpose.
EOF
}

# A door for a person, today's usage for anything without a keyboard. One notion of
# "interactive" — have_tty — reused rather than a second one invented. Options 1 and 3
# still hit require_tty inside the commands they call, so the menu inherits the boundary.
cmd_menu() {
  printf '\n  %s%sWhat would you like to do?%s\n' "$B" "$RED" "$R"
  cat <<'EOF' 

    1  Start something new         a folder for it, and me in it
    2  Open your page              the buttons and the commands
    3  Keep a key safe             a password or an API key
    4  See what keys you have      names only, never the values
    5  Lock your keys
    6  Just show me the commands

EOF
  printf '  Type a number and press Enter: '
  IFS= read -r choice
  case "$choice" in
    1) note "Not built yet — ask me in the chat and I'll make it for you.";;
    2) cmd_site;;
    3) printf '  What should it be called (e.g. OPENAI_API_KEY)? '; IFS= read -r n
       printf '  Just this project, or everywhere? [project/global] '; IFS= read -r sc
       cmd_add "$n" "${sc:-project}";;
    4) cmd_list;;
    5) cmd_lock;;
    6) usage;;
    7) cmd_uninstall;;
    *) note "I didn't catch that. Run mwk again and type a number.";;
  esac
}

case "${1:-}" in
  init) shift; cmd_init "$@";;
  site) shift; cmd_site "$@";;
  queue) shift; cmd_queue "$@";;
  uninstall) shift; cmd_uninstall "$@";;
  add) shift; cmd_add "$@";;
  list|ls) shift; cmd_list "$@";;
  run) shift; cmd_run "$@";;
  needs) shift; cmd_needs "$@";;
  lock) shift; cmd_lock "$@";;
  rekey) shift; cmd_rekey "$@";;
  "") if have_tty; then cmd_menu; else usage; fi ;;
  -h|--help|help) usage;;
  *) die "unknown command '$1' — try 'mwk help'";;
esac
